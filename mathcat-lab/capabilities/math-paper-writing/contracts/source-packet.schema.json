{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-paper-writing/source-packet.schema.json",
  "title": "Structured mathematics paper Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "writing_goal", "core_results", "source_materials", "citation_whitelist", "evidence_gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "writing_goal": {
      "type": "object",
      "required": ["deliverable", "audience", "language"],
      "properties": {
        "deliverable": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "language": {"enum": ["en", "zh", "bilingual"]},
        "venue": {"type": ["string", "null"]}
      }
    },
    "core_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "sources"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["proved", "audited", "computational_evidence", "conjectural", "open"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "allowed_role": {"type": "string"}
        }
      }
    },
    "source_materials": {"type": "array", "items": {"type": "object"}},
    "citation_whitelist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  }
}
